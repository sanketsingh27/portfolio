# AI remains disabled until you configure an external provider and usage controls.
AI_ENABLED=false
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=

# Set these only after configuring actual provider spend limits and Vercel
# Firewall/rate limiting for /api/chat. These attestations do not enforce limits.
AI_SPEND_LIMIT_CONFIGURED=false
AI_ABUSE_PROTECTION_CONFIGURED=false
